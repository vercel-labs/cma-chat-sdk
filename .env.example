# Bot Configuration
BOT_USERNAME=claude-research-bot

# Claude Managed Agents
# API key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Printed by `npm run cma:setup` (one-time provisioning).
CLAUDE_AGENT_ID=agent_...
CLAUDE_ENVIRONMENT_ID=env_...

# Optional: post per-turn diagnostics and a Claude Console link in Slack.
# CLAUDE_DEBUG_MODE=true

# Slack (Vercel Connect connector UID)
SLACK_CONNECTOR=slack/claude-research-bot

# Redis (e.g., Upstash Redis)
# Required for webhook deduplication, subscriptions, and thread/session state.
REDIS_URL=
